[Unit]
Description=Minimal Spring App llama-server sidecar
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=minimal-spring-app
Group=minimal-spring-app
WorkingDirectory=/opt/minimal-spring-app
EnvironmentFile=-/etc/minimal-spring-app/app.env
EnvironmentFile=-/etc/minimal-spring-app/llama-server.env
ExecCondition=/bin/sh -c '[ "${POST_AI_MODERATION_ENABLED}" = "true" ]'
ExecStart=/bin/sh /opt/minimal-spring-app/scripts/ai/run-llama.sh
ExecStartPost=/bin/sh /opt/minimal-spring-app/scripts/ai/health-llama.sh ${LLAMA_HEALTH_URL} ${LLAMA_STARTUP_TIMEOUT_SECONDS}
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
