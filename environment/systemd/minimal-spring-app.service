[Unit]
Description=Minimal Spring App
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=minimal-spring-app
Group=minimal-spring-app
WorkingDirectory=/opt/minimal-spring-app
Environment=APP_ENV=prod
EnvironmentFile=-/etc/minimal-spring-app/app.env
ExecStart=/usr/bin/java --add-modules jdk.incubator.vector --enable-preview -jar /opt/minimal-spring-app/app.jar --spring.profiles.active=${APP_ENV}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
