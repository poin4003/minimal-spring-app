# Local Makefile profile. Render starts application.yaml without this profile.
APP_ENV=dev

# Server
PORT=8080
SPRING_APPLICATION_NAME=minimal-spring-app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication
ACCESS_TOKEN_COOKIE_NAME=ACCESS_TOKEN
REFRESH_TOKEN_COOKIE_NAME=REFRESH_TOKEN
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=true
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Bootstrap administrator
BOOTSTRAP_ADMIN_EMAIL=system@admin.com
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-bcrypt-password-hash
BOOTSTRAP_ADMIN_NAME=System Administrator

# Database
DATABASE_URL=jdbc:h2:file:./data/minimal_db
DATABASE_DRIVER=org.h2.Driver
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
FLYWAY_ENABLED=true
H2_CONSOLE_ENABLED=false
H2_CONSOLE_PATH=/h2-console

# Cache
KEY_STORE_CACHE_MAXIMUM_SIZE=100000
KEY_STORE_CACHE_TTL=1m

# Media storage and delivery
MEDIA_STORAGE_PATH=./data/media
MEDIA_PUBLIC_PATH=/api/v1/public/media
MEDIA_DELIVERY_CACHE_DURATION=365d
MEDIA_MAX_IMAGE_PIXELS=40000000
MULTIPART_MAX_FILE_SIZE=16MB
MULTIPART_MAX_REQUEST_SIZE=20MB

# Media thumbnail
MEDIA_THUMBNAIL_ENABLED=true
MEDIA_THUMBNAIL_MAX_WIDTH=480
MEDIA_THUMBNAIL_MAX_HEIGHT=480
MEDIA_THUMBNAIL_JPEG_QUALITY=0.82
MEDIA_THUMBNAIL_VIDEO_FRAME_SECOND=1
MEDIA_THUMBNAIL_AUDIO_COVER_ENABLED=true

# Chunk upload
MEDIA_CHUNK_SIZE_BYTES=8388608
MEDIA_DIRECT_UPLOAD_THRESHOLD_BYTES=16777216
MEDIA_PARALLEL_CHUNKS=3
MEDIA_MAX_ACTIVE_UPLOAD_SESSIONS_PER_USER=5
MEDIA_MAX_RESERVED_UPLOAD_BYTES_PER_USER=2147483648
MEDIA_UPLOAD_SESSION_TTL=24h
MEDIA_UPLOAD_MAX_SESSION_LIFETIME=72h
MEDIA_COMPLETED_SESSION_RETENTION=24h

# FFmpeg and HLS
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_SEGMENT_DURATION_SECONDS=6
FFMPEG_PROCESS_TIMEOUT_MINUTES=30
MEDIA_HLS_AUDIO_BITRATE=192000

# Media maintenance
MEDIA_PENDING_RECOVERY_TTL=15m
MEDIA_STAGING_TTL=1h
MEDIA_PROCESSING_WORKSPACE_TTL=2h
MEDIA_FAILED_ARTIFACT_TTL=24h
MEDIA_ORPHAN_DIRECTORY_TTL=24h
MEDIA_MISSING_ORIGINAL_AUDIT_TTL=10m
MEDIA_MAINTENANCE_BATCH_SIZE=100

# Notification
NOTIFICATION_TTL=30d
NOTIFICATION_HARD_LIMIT=100
NOTIFICATION_SSE_TIMEOUT=30m
NOTIFICATION_SSE_HEARTBEAT=20s

# Email
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=no-reply@example.com
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# Telegram
NOTIFICATION_TELEGRAM_ENABLED=false
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CACHE_MAX_SIZE=100000
RATE_LIMIT_CACHE_EXPIRATION=1h

# UI
UI_LOGIN_PATH=/login
UI_HOME_PATH=/admin
UI_LOGOUT_PATH=/logout
UI_APPLICATION_TITLE=Minimal Spring App
THYMELEAF_CACHE=true
SWAGGER_ENABLED=false

# JPA and logging
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
HIBERNATE_HIGHLIGHT_SQL=false
LOG_LEVEL_HIBERNATE_SQL=INFO
LOG_LEVEL_HIBERNATE_BIND=INFO
LOG_LEVEL_SPRING_JDBC=INFO
LOG_LEVEL_SQL_CONNECTION=INFO
LOG_LEVEL_SQL=INFO

# JobRunr
JOBRUNR_WORKER_COUNT=2
JOBRUNR_POLL_INTERVAL=30s
JOBRUNR_DELETE_SUCCEEDED_AFTER=3d
JOBRUNR_PERMANENT_DELETE_AFTER=1d
JOBRUNR_FAILED_JOB_RETENTION=30d
JOBRUNR_DASHBOARD_ENABLED=false
JOBRUNR_DASHBOARD_PORT=8000
